# Normalise line endings in the repository; check out scripts with the
# endings their shell needs, whatever the contributor's core.autocrlf is.
* text=auto
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.jar binary
*.png binary
*.webp binary
# Pinned third-party solver scripts (ADR-0009): byte-exact, hash-checked by a unit test.
core/innertube/src/main/resources/dk/backrow/core/innertube/ejs/*.js -text
